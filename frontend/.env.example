# Copy this file to .env and fill in real values before running `npm run build`.
# react-scripts inlines REACT_APP_* vars into the compiled bundle at build time,
# so these must be set locally before building — the Dockerfile only copies the
# pre-built build/ folder into the image (Kaniko does not run the build).
REACT_APP_AUTH0_DOMAIN=
REACT_APP_AUTH0_CLIENT_ID=
REACT_APP_AUTH0_AUDIENCE=

# Host:port (or hostname) of the container registry that stock lab-environment
# images and custom-built lab images are pushed to/pulled from. In the local
# kindling dev cluster this is the in-cluster registry service, "registry:5000".
# In production this must point at whatever registry that environment's
# `builder` service (REGISTRY env var) actually pushes images to — they must
# match, or lab pods will fail to pull their images.
REACT_APP_IMAGE_REGISTRY=
