# Copy this file to .env and fill in real values before running `npm run build`.
# react-scripts inlines REACT_APP_* vars into the compiled bundle at build time,
# so these must be set locally before building — the Dockerfile only copies the
# pre-built build/ folder into the image (Kaniko does not run the build).
REACT_APP_AUTH0_DOMAIN=
REACT_APP_AUTH0_CLIENT_ID=
REACT_APP_AUTH0_AUDIENCE=
